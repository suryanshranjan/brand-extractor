# Copy to .env and fill in. Real environment variables override this file.

# Where sessions, results, cache, the job database and logs are stored (default: current folder)
# BRANDSCAN_DATA_DIR=./data

# --- Data source ---
# web   = Instagram's website API with a logged-in account (more data, against Instagram's terms)
# graph = official Instagram Graph API "Business Discovery" (compliant; business/creator accounts only)
BRANDSCAN_SOURCE=web

# web source: account whose saved session to use (create it with `brandscan login USER`
# or `brandscan import-cookies cookies.json --as USER`), or a raw sessionid cookie
IG_LOGIN=
IG_SESSIONID=
BRANDSCAN_PROXY=
BRANDSCAN_HOURLY_CAP=200

# graph source: long-lived token + the IG user id of your own professional account
IG_GRAPH_TOKEN=
IG_GRAPH_USER_ID=
IG_GRAPH_VERSION=v21.0

# --- OCR (reading sponsor logos/posters) ---
# auto = OCR.space if a key is set, else local EasyOCR if installed, else off
BRANDSCAN_OCR=auto
# Free key: https://ocr.space/ocrapi
OCRSPACE_API_KEY=

BRANDSCAN_MAX_LOOKUPS=80

# --- Web service ---
# Comma-separated name:key pairs. Each key only sees its own scans. Required when serving publicly.
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(24))"
BRANDSCAN_API_KEYS=
